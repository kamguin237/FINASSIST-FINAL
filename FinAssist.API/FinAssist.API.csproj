      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FinAssist.Core\FinAssist.Core.csproj" />
    <ProjectReference Include="..\FinAssist.Infrastructure\FinAssist.Infrastructure.csproj" />
    <ProjectReference Include="..\FinAssist.Application\FinAssist.Application.csproj" />
  </ItemGroup>

</Project>
